{
  "name": "typetrack",
  "version": "0.1.0",
  "description": "Typed, zero-runtime-cost analytics SDK.",
  "keywords": [
    "analytics",
    "typescript",
    "tracking",
    "telemetry",
    "events",
    "provider-agnostic",
    "type-safe"
  ],
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevKovan/typetrack.git"
  },
  "homepage": "https://github.com/DevKovan/typetrack#readme",
  "bugs": {
    "url": "https://github.com/DevKovan/typetrack/issues"
  },
  "workspaces": [
    "benchmarks",
    "e2e",
    "packages/*",
    "examples/core/*",
    "examples/providers/*",
    "examples/middleware/*",
    "examples/validation/*",
    "examples/plugins/*",
    "examples/recipes/*",
    "examples/advanced/*",
    "examples/runtimes/bun",
    "examples/frameworks/vue",
    "examples/frameworks/svelte",
    "examples/frameworks/solid"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "bin": {
    "typetrack": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:all": "bun run build && bun install && cd packages/react && bun run build && cd ../next && bun run build && cd ../vue && bun run build && cd ../nuxt && bun run build && cd ../svelte && bun run build && cd ../solid && bun run build && cd ../astro && bun run build && cd ../remix && bun run build",
    "lint": "oxlint",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test --conditions=browser --path-ignore-patterns='e2e/**' --path-ignore-patterns='benchmarks/tests/**'",
    "knip": "knip",
    "size": "size-limit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "chokidar": "^5.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@size-limit/file": "13.0.3",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "6.31.0",
    "oxlint": "1.76.0",
    "size-limit": "13.0.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  }
}
