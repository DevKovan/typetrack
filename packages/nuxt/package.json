{
  "name": "@typetrack/nuxt",
  "version": "0.0.0",
  "description": "Nuxt 4 module (SSR-safe provide/inject registration, automatic route-change pageview tracking) for typetrack.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "oxlint",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  },
  "dependencies": {
    "@typetrack/vue": "workspace:*",
    "typetrack": "file:../.."
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@nuxt/kit": "4.5.1",
    "@nuxt/schema": "4.5.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "knip": "6.31.0",
    "nuxt": "4.5.1",
    "oxlint": "1.76.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vue": "3.5.41"
  }
}
