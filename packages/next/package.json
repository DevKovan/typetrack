    "test": "bun test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0"
  },
  "dependencies": {
    "@typetrack/react": "file:../react",
    "typetrack": "file:../.."
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "knip": "6.31.0",
    "next": "16.2.12",
    "oxlint": "1.76.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
