{
  "name": "@typetrack/vue",
  "version": "0.1.0",
  "description": "Vue 3 bindings (plugin + useAnalytics composable) for typetrack.",
  "keywords": [
    "analytics",
    "typescript",
    "typetrack",
    "vue",
    "vue3"
  ],
  "license": "MIT",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevKovan/typetrack.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/DevKovan/typetrack/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/DevKovan/typetrack/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "oxlint",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "typetrack": "file:../.."
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.11.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vue/server-renderer": "3.5.41",
    "@vue/test-utils": "2.4.11",
    "knip": "6.31.0",
    "oxlint": "1.76.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vue": "3.5.41"
  }
}
