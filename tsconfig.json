{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["bun"],
    "strict": true,
    "ignoreDeprecations": "6.0",
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "declaration": true,
    "noEmit": true,
    "paths": {
      "typetrack": ["./src/index.ts"],
      "@typetrack/react": ["./packages/react/src/index.ts"],
      "@typetrack/vue": ["./packages/vue/src/index.ts"]
    }
  },
  "include": ["src", "packages/*/src", "examples/core/*", "examples/providers/*", "examples/middleware/*", "examples/validation/*", "examples/plugins/*", "examples/recipes/*", "examples/frameworks/vue", "examples/frameworks/svelte", "examples/frameworks/solid", "tsup.config.ts", "e2e"]
}
