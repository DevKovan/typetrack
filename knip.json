{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // `packages/nuxt/src/runtime/plugin.ts`/`pageview.client.ts` statically
  // import `#typetrack/analytics-module` -- a Nuxt build-time alias
  // `packages/nuxt/src/module.ts`'s `setupTypetrackModule()` registers into
  // `nuxt.options.alias` at real Nuxt build time (see that file's header
  // comment), resolved for `tsgo`/`tsc` purposes via an ambient module
  // declaration (`packages/nuxt/src/runtime/analytics-module.d.ts`) rather
  // than a real file on disk. Knip's static analysis doesn't understand
  // ambient module declarations for import-resolution purposes (confirmed
  // by hand), so it otherwise reports this specifier as an unresolved
  // import -- a false positive for a deliberately virtual specifier, not a
  // real defect (mirrors this repo's own pre-existing, documented knip
  // limitation for `.vue`/`.svelte`/`.astro` template markup).
  "ignoreUnresolved": ["^#typetrack/"],
  "workspaces": {
    ".": {
      "entry": ["src/index.ts", "src/devServer/index.ts", "src/cli/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/*": {},
    "packages/astro": {
      // `packages/astro/src/buildPageLoadScript.ts`'s injected script
      // contains a literal `import { dispatchPageView } from "typetrack";`
      // line -- but that line lives inside a JS *string* (the content
      // `injectScript()` hands to Astro's own Vite pipeline at real build
      // time, resolved only once a real Astro app's browser bundle
      // executes it), not a real TS `import` statement anywhere in this
      // package's own source. Knip's static analysis, correctly, sees no
      // real import of `typetrack` anywhere in `packages/astro/src` and
      // reports the package.json dependency as unused -- a false positive
      // for this package's own genuinely-virtual, string-templated import
      // (mirrors this repo's own pre-existing, documented
      // `ignoreUnresolved` entry above for `@typetrack/nuxt`'s equivalent
      // build-time-only specifier, just the inverse direction: an
      // over-eager "unused dependency" finding here, instead of an
      // over-eager "unresolved import" finding there). The dependency
      // itself is required at real Astro build/runtime time (see
      // `package.json`'s own `dependencies.typetrack` and this issue's
      // acceptance criteria), not actually unused.
      "ignoreDependencies": ["typetrack"]
    },
    "e2e": {
      // Knip's built-in Playwright plugin already auto-detects
      // `playwright.config.ts` and `tests/**/*.spec.ts` as entries -- only
      // `server.ts` needs an explicit entry here: it's started by
      // `playwright.config.ts`'s `webServer.command` as a shell string
      // (`"bun run server.ts"`), not a static `import`, so knip's
      // import-graph analysis can't discover it that way.
      "entry": ["server.ts"],
      // `e2e/fixtures/*.html` `<script src="/dist/index.global.js">`-load
      // the repo root's real built artifact via a plain HTTP path
      // `server.ts` itself resolves against the filesystem (see that
      // file's own `repoRoot`/`join()` logic) -- not a package import
      // resolved through `node_modules/typetrack`. This mirrors
      // `packages/astro`'s own `ignoreDependencies` entry above (a
      // genuinely-required dependency with no real static TS `import`
      // anywhere for knip to trace): `dependencies.typetrack` in
      // `e2e/package.json` exists so this workspace explicitly depends on
      // (and `bun install` links against) the root package whose `dist/`
      // build output these specs verify, per this issue's own acceptance
      // criteria -- not an accidentally-unused dependency.
      "ignoreDependencies": ["typetrack"]
    }
  }
}
